# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Your server's LAN IP — required for QR pairing
DOCKERTAB_HOST=192.168.1.50
# Friendly name shown in the iOS app
DOCKERTAB_NAME="Home Server"
# DOCKERTAB_PORT=8377
# DOCKERTAB_BIND=0.0.0.0
# DOCKERTAB_API_KEY=             # auto-generated on first run
# DOCKERTAB_JWT_SECRET=          # auto-generated on first run
# DOCKERTAB_LOG_LEVEL=info
# DOCKERTAB_RELAY_URL=
# DOCKERTAB_RELAY_TOKEN=
